# Variables de conexión a base de datos
# Descomenta y ajusta según tu proveedor (Neon, Supabase, PostgreSQL local)
DATABASE_URL=postgresql://usuario:password@host:5432/neondb?sslmode=require

# URL del microservicio OCR (Python/FastAPI). Si no está corriendo,
# el flujo activa un fallback seguro automáticamente.
OCR_SERVICE_URL=http://127.0.0.1:8000/extraer

# ID del tenant para pruebas de conexión (npm run db:check)
DB_CHECK_TENANT_ID=11111111-1111-4111-8111-111111111111

# ID del tenant para el flujo real (npm run flow:run)
FLOW_TENANT_ID=11111111-1111-4111-8111-111111111111

# Configuración de entrada automática (npm run ingesta:start)
PORT=3000
INBOX_DIR=./inbox
WATCHER_INTERVAL_SEC=10
